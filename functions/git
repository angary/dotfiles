#!/usr/bin/env bash

# Commit all and push
function gacp() {
	if [[ $# -eq 0 ]]; then
		git add --all && git commit --amend --no-edit && git push --force
	else
		git add --all && git commit -m "$1" && git push
	fi
}

# Delete branch matching regex
function gbd() {
  	git branch --list "$1" | xargs -n 1 git branch -D
}

# List local branches by last author date
function gbb() {
	local gray=$'\x1b[90m'
	local reset=$'\x1b[0m'

	git for-each-ref \
		--sort='-authordate:iso8601' \
		--format='%(authordate:relative)%09%(refname:short)' \
		refs/heads |
	while IFS=$'\t' read -r relative_date branch; do
		printf '%s%s%s\t%s\n' "$gray" "$relative_date" "$reset" "$branch"
	done
}

# Fuzzy git checkout for branches
function gch() {
	git checkout "${1:-$(git branch --all | fzf | awk '{print $1}')}"
}

# Git checkout remote
function gchr() {
	git fetch origin "$1":"$1" && git checkout "$1"
}

# Git checkout head
function gchh() {
	git checkout HEAD -- "$1"
}

# Git fetch checkout
function gfc() {
	git fetch origin "$1" && git checkout FETCH_HEAD -b "$1"
}

# Fuzzy git merge for branches
function gmr() {
	git merge "${1:-$(git branch --all | fzf | awk '{print $1}')}"
}

# Fuzzy git rebase for branches
function grb() {
	git rebase "${1:-$(git branch --all | fzf | awk '{print $1}')}"
}

# Git fetch, rebase and force push
function gfrp() {
	git fetch origin "$1":"$1" && git rebase "$1" && git push --force
}

# Reset with remote
function grr() {
	local branch=${1:-$(git branch --show-current)}
	git fetch origin "$branch" && git reset --hard "origin/$branch"
}
